      {
        "step": 1,
        "title": "Prepare Code",
        "tasks": [
          "Create GitHub repository",
          "Push all files to GitHub",
          "Ensure .env.example files are present"
        ]
      },
      {
        "step": 2,
        "title": "Deploy Backend to Render",
