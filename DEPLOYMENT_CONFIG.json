{
  "deployment_summary": {
    "project": "Emlak AI - Prime AI Real Estate Valuation",
    "platforms": {
      "backend": {
        "platform": "Render",
        "runtime": "Python 3.12",
        "build_command": "cd backend && pip install -r requirements.txt",
        "start_command": "cd backend && gunicorn -w 4 -k uvicorn.workers.UvicornWorker main:app",
        "environment_variables": {
          "GEMINI_API_KEY": "required",
          "PYTHON_VERSION": "3.12"
        },
        "estimated_cost": "Free tier available (0 TL/month)",
        "files_needed": [
          "backend/requirements.txt",
          "backend/main.py",
          "backend/gemini_service.py",
          "backend/render.yaml",
          "backend/.env.example"
        ]
      },
      "frontend": {
        "platform": "Vercel",
        "runtime": "Node.js",
        "build_command": "npx expo export --platform web",
        "output_directory": ".expo/dist/client",
        "install_command": "npm install && npx expo install",
        "environment_variables": {
          "VITE_API_URL": "https://your-backend.render.com"
        },
        "estimated_cost": "Free tier available (0 TL/month)",
        "files_needed": [
          "App.tsx",
          "package.json",
          "vercel.json",
          ".env.example"
        ]
      }
    },
